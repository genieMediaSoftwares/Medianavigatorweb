# GEMINI_API_KEY: Required for Gemini AI API calls and video/media analysis.
# In local development, define this in your local .env file.
# On Vercel, configure this in Project Settings > Environment Variables.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Port for the Express server (defaults to 3000).
PORT=3000
