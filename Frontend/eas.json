{
  "cli": {
    "version": ">= 24.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://medianavigator-api.onrender.com"
      }
    },
    "production": {
      "distribution": "store",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "environment": "production",
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false, "buildConfiguration": "Release" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://medianavigator-api.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
